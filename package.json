{
  "name": "turbo-browser-mcp",
  "version": "0.7.1",
  "description": "MCP server for browser automation on Playwright. It fills whole forms and runs action lists in one call, returns only changed elements, and blocks final Submit clicks by default.",
  "type": "module",
  "main": "./src/index.mjs",
  "bin": {
    "turbo-browser-mcp": "src/index.mjs"
  },
  "files": [
    "src/",
    "skills/",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "start": "node ./src/index.mjs",
    "test": "node --import ./test/setup-home.mjs --test --test-concurrency=4 test/*.test.mjs",
    "doctor": "node ./src/index.mjs --doctor",
    "bridge": "node ./src/index.mjs --bridge",
    "launch-chrome": "node ./src/index.mjs --launch-chrome",
    "benchmark": "node ./benchmarks/benchmark.mjs",
    "benchmark:e2e": "node ./benchmarks/e2e-tasks.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "playwright",
    "browser-automation",
    "cdp",
    "shadow-dom",
    "llm-agent"
  ],
  "author": "Trung Thanh Tran",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "playwright-core": ">=1.49.0"
  }
}
